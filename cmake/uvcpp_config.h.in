#endif
#ifndef UVCPP_CAPI_ENABLE
#  define UVCPP_CAPI_ENABLE @UVCPP_CAPI_ENABLE@
#endif

#if defined(UVCPP_REDIS_ENABLE) && (UVCPP_REDIS_ENABLE != @UVCPP_REDIS_ENABLE@)
