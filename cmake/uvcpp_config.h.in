#endif
#ifndef UVCPP_REDIS_ENABLE
#  define UVCPP_REDIS_ENABLE @UVCPP_REDIS_ENABLE@
#endif

#if defined(UVCPP_DB_ENABLE) && (UVCPP_DB_ENABLE != @UVCPP_DB_ENABLE@)
#  error "UVCPP_DB_ENABLE=@UVCPP_DB_ENABLE@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_DB_ENABLE
#  define UVCPP_DB_ENABLE @UVCPP_DB_ENABLE@
#endif

/* 后端宏：模块关掉时它们是 0（不是"未定义"）。写成"未定义"的话
   `#if UVCPP_DB_SQLITE_ENABLE` 求值也是 0，结果碰巧一样 —— 而碰巧一样的东西
   在 `-Wundef` 下会变成一条警告，且它自己说不清"这个后端是关着还是模块没编"。 */
#if defined(UVCPP_DB_SQLITE_ENABLE) && (UVCPP_DB_SQLITE_ENABLE != @UVCPP_DB_SQLITE_ENABLE@)
#  error "UVCPP_DB_SQLITE_ENABLE=@UVCPP_DB_SQLITE_ENABLE@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_DB_SQLITE_ENABLE
#  define UVCPP_DB_SQLITE_ENABLE @UVCPP_DB_SQLITE_ENABLE@
#endif

#if defined(UVCPP_DB_MYSQL_ENABLE) && (UVCPP_DB_MYSQL_ENABLE != @UVCPP_DB_MYSQL_ENABLE@)
#  error "UVCPP_DB_MYSQL_ENABLE=@UVCPP_DB_MYSQL_ENABLE@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_DB_MYSQL_ENABLE
#  define UVCPP_DB_MYSQL_ENABLE @UVCPP_DB_MYSQL_ENABLE@
#endif

#if defined(UVCPP_DB_PGSQL_ENABLE) && (UVCPP_DB_PGSQL_ENABLE != @UVCPP_DB_PGSQL_ENABLE@)
#  error "UVCPP_DB_PGSQL_ENABLE=@UVCPP_DB_PGSQL_ENABLE@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_DB_PGSQL_ENABLE
#  define UVCPP_DB_PGSQL_ENABLE @UVCPP_DB_PGSQL_ENABLE@
#endif

/* ODBC 后端。注意它与上面三个不是一类：SQLite/MySQL/PostgreSQL 各对着**一种**
   数据库，而这个对着**一个接口** —— 连什么库由连接串里的 `Driver=`（或 `DSN=`）
   决定，本驱动不去试别的驱动名。所以"这个后端在不在"与"要连的那个数据源有没有
   驱动"是两件事：后者要到 `open()` 才知道，报错是驱动管理器给的原文（驱动名写错
   时就是它那句"找不到数据源、也没有默认驱动"）。 */
#if defined(UVCPP_DB_ODBC_ENABLE) && (UVCPP_DB_ODBC_ENABLE != @UVCPP_DB_ODBC_ENABLE@)
#  error "UVCPP_DB_ODBC_ENABLE=@UVCPP_DB_ODBC_ENABLE@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_DB_ODBC_ENABLE
#  define UVCPP_DB_ODBC_ENABLE @UVCPP_DB_ODBC_ENABLE@
#endif

/* MongoDB 后端。它与上面几个的**失败方式**不同：客户端库本仓不随包分发，
   所以"这份构建有没有编 MongoDB"（编译期，看 mongoc.h 在不在）与"这台机器
   装没装 libmongoc/libbson"（运行期，第一次 open() 才知道）是两件事。前者看
   这个宏，后者看 open() 的返回值（两种都是 NO_DRIVER，last_error() 分开说）。 */
#if defined(UVCPP_DB_MONGODB_ENABLE) && (UVCPP_DB_MONGODB_ENABLE != @UVCPP_DB_MONGODB_ENABLE@)
#  error "UVCPP_DB_MONGODB_ENABLE=@UVCPP_DB_MONGODB_ENABLE@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_DB_MONGODB_ENABLE
#  define UVCPP_DB_MONGODB_ENABLE @UVCPP_DB_MONGODB_ENABLE@
#endif

/* MySQL / PostgreSQL 两个后端的符号是**链接进来的**还是**运行时取**的。
   它是"这份产物长什么样"，不是"有哪些模块"，但同样必须让使用者看得见：这两条
   路的**失败方式**不一样（链接的那条在加载期就报缺库、进程起不来；运行时加载的
   那条进程照起，真去连时才拿到 NO_DRIVER），而使用者拿到一句错误信息之后要判断的
   正是"这是我没装库还是这份包没编这个后端"。 */
#if defined(UVCPP_DB_RUNTIME_LOAD) && (UVCPP_DB_RUNTIME_LOAD != @UVCPP_DB_RUNTIME_LOAD@)
#  error "UVCPP_DB_RUNTIME_LOAD=@UVCPP_DB_RUNTIME_LOAD@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_DB_RUNTIME_LOAD
#  define UVCPP_DB_RUNTIME_LOAD @UVCPP_DB_RUNTIME_LOAD@
#endif

#if defined(UVCPP_ENABLE_MEMORY_POOL) && (UVCPP_ENABLE_MEMORY_POOL != @UVCPP_ENABLE_MEMORY_POOL@)
#  error "UVCPP_ENABLE_MEMORY_POOL=@UVCPP_ENABLE_MEMORY_POOL@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_ENABLE_MEMORY_POOL
#  define UVCPP_ENABLE_MEMORY_POOL @UVCPP_ENABLE_MEMORY_POOL@
#endif

#if defined(UVCPP_TRY_WRITE_ENABLE) && (UVCPP_TRY_WRITE_ENABLE != @UVCPP_TRY_WRITE_ENABLE@)
#  error "UVCPP_TRY_WRITE_ENABLE=@UVCPP_TRY_WRITE_ENABLE@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_TRY_WRITE_ENABLE
#  define UVCPP_TRY_WRITE_ENABLE @UVCPP_TRY_WRITE_ENABLE@
#endif

/* A value macro, not a 0/1 switch -- compared against its own literal. */
#if defined(UVCPP_TRY_WRITE_MIN_BYTES) && (UVCPP_TRY_WRITE_MIN_BYTES != @UVCPP_TRY_WRITE_MIN_BYTES@)
#  error "UVCPP_TRY_WRITE_MIN_BYTES=@UVCPP_TRY_WRITE_MIN_BYTES@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_TRY_WRITE_MIN_BYTES
#  define UVCPP_TRY_WRITE_MIN_BYTES @UVCPP_TRY_WRITE_MIN_BYTES@
#endif

#if defined(UVCPP_UDP_GSO_ENABLE) && (UVCPP_UDP_GSO_ENABLE != @UVCPP_UDP_GSO_ENABLE@)
#  error "UVCPP_UDP_GSO_ENABLE=@UVCPP_UDP_GSO_ENABLE@ in this build; remove your own definition of it"
#endif
#ifndef UVCPP_UDP_GSO_ENABLE
#  define UVCPP_UDP_GSO_ENABLE @UVCPP_UDP_GSO_ENABLE@
#endif

#endif /* UVCPP_GENERATED_CONFIG_H */
